# Copy this file to .env and replace the placeholder values.
# .env is ignored by Git. Never put real secrets in .env.example.

# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (runs in Docker, bound to 127.0.0.1 only) ---
# docker-compose.yml reads these same values to create the database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=payops
POSTGRES_USER=payops_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Read-only login for analytics and agents. The data loader creates it with this password.
READONLY_DB_USER=payops_readonly
READONLY_DB_PASSWORD=change-me-to-a-different-long-random-string

# --- Local LLM (Ollama). Must be a localhost address: the app refuses anything else. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Current PC: qwen3:4b for daily development. New PC (RTX 5070 Ti): try qwen3:8b or qwen3:14b.
OLLAMA_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=60

# Seconds each health check may wait before reporting "unreachable".
HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Dashboard -> API (must be local) ---
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=120

# --- Make sure no hosted tracing is ever switched on by a library default ---
LANGCHAIN_TRACING_V2=false
