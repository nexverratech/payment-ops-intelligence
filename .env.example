# Copy this file to .env and replace the placeholder values.
# .env is ignored by Git. Never put real secrets in .env.example.

# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (runs in Docker, bound to 127.0.0.1 only) ---
# docker-compose.yml reads these same values to create the database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=payops
POSTGRES_USER=payops_admin
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Read-only login for analytics and agents. The data loader creates it with this password.
READONLY_DB_USER=payops_readonly
READONLY_DB_PASSWORD=change-me-to-a-different-long-random-string

# Application login: investigations, checkpoints, accounts, sessions and the audit log (schema "ops"),
# nothing else. Create it with: python -m payops.db.setup_app
# Required for sign-in: if empty, the API refuses every request except /health (the CLI still works, unsaved).
APP_DB_USER=payops_app
APP_DB_PASSWORD=change-me-to-a-third-long-random-string

# --- Local LLM (Ollama). Must be a localhost address: the app refuses anything else. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Current PC: qwen3:4b for daily development. New PC (RTX 5070 Ti): try qwen3:8b or qwen3:14b.
OLLAMA_MODEL=qwen3:4b
# Seconds one LLM reply may take. Writing the report can take a minute or more on a laptop GPU.
LLM_TIMEOUT_SECONDS=180
# Most LLM calls one investigation may make (plan + report, each with one retry).
LLM_MAX_CALLS=4
# Tokens the model may read per call (Ollama's default is 4096; the report prompt needs more).
LLM_CONTEXT_TOKENS=8192

# --- Sign-in ---
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
# Request bodies larger than this (bytes) are refused with 413.
MAX_REQUEST_BYTES=65536

# --- Execution limits ---
# Wall-clock budget for one investigation; when spent, remaining analysis steps are skipped
# and you get a labelled partial report (resumable).
INVESTIGATION_TIMEOUT_SECONDS=600
# Investigations the API runs at the same time (they share one local GPU); more get "busy, try again".
MAX_CONCURRENT_INVESTIGATIONS=2

# Seconds each health check may wait before reporting "unreachable".
HEALTH_CHECK_TIMEOUT_SECONDS=3

# --- Dashboard -> API (must be local) ---
API_BASE_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=300

# --- Make sure no hosted tracing is ever switched on by a library default ---
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
