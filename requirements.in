# Direct dependencies for Phase 1, with the minimum versions this code relies on.
# These are NOT the pins. The exact pins live in requirements.lock, which is
# generated by `pip freeze` on a machine where the tests passed (see README).
#
# Every package below is free, runs locally, and needs no account or API key.
# Licences are listed in docs/dependency_inventory.md.

fastapi>=0.115           # HTTP API framework
uvicorn>=0.32            # Server that runs the FastAPI app
pydantic>=2.9,<3         # Data validation (v3 would be a breaking change)
pydantic-settings>=2.6,<3  # Reads configuration from .env / environment
sqlalchemy>=2.0.36,<2.1  # Safe, parameterized SQL and connection pooling
psycopg[binary]>=3.2,<4  # PostgreSQL driver (binary build: no compiler needed on Windows)
httpx2>=2.13             # HTTP client for the local Ollama API; Starlette's TestClient prefers it over the older httpx
pytest>=8.3              # Test runner
pandas>=2.2              # Data generation and table-shaped analysis
numpy>=2.0               # Fast random numbers and arrays (the seeded generator)
